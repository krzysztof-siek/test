# Supabase Configuration (Server-only secrets)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# OpenRouter API Configuration (Server-only secret)
OPENROUTER_API_KEY=your-openrouter-api-key

# Public Client Variables (available on client and server)
PUBLIC_OPENROUTER_API_KEY=optional-public-key
PUBLIC_APP_NAME=10x Cards by Krzysiek

# Site Configuration (Public server variable)
SITE=https://your-domain.com